# Generated by Cargo
# will have compiled files and executables
/target/

# Local config (created by `relay init`, never checked in)
/relay.toml
/relay.local.toml
/data/

# Wrangler / miniflare local cache + state (R2 emulation, etc.)
/.wrangler/
# build artifacts from running the vendored yrs test suite in place
/vendor/yrs/target/
